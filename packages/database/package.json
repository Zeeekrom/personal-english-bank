{
  "name": "@peb/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "prisma generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.2.3",
    "mssql": "^12.0.2"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "vitest": "^4.0.18"
  }
}
